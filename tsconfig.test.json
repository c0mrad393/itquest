{
  "//": "Transpiles the pure model modules so tests/*.mjs can run them on bare node. Inherits the path aliases from the root config; overrides only module/target/output.",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": ".test-build",
    "module": "esnext",
    "target": "es2020",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "jsx": "preserve"
  },
  "include": ["lib/core/rack.ts", "lib/core/datacenter.ts", "lib/core/fileshares.ts", "lib/core/directory.ts", "lib/core/growth.ts", "lib/core/policy.ts", "lib/core/poe.ts", "lib/core/ipam.ts", "lib/core/traffic.ts", "lib/core/backup.ts", "lib/core/incident.ts", "lib/tickets/ambient.ts", "lib/progression/unlocks.ts", "lib/tickets/hints.ts", "lib/core/cascade.ts", "lib/hardware/types.ts", "lib/tutorial/flow.ts"]
}
